{
    "id": "division-region-label",
    "type": "symbol",
    "source": "divisions",
    "source-layer": "division",
    "maxzoom": 10,
    "filter": [
        "all",
        [
            "in",
            ["get", "subtype"],
            [
                "literal",
                ["region", "macroregion"]
            ]
        ],
        [
            "<=",
            [
                "length",
                ["get", "@name"]
            ],
            [
                "step",
                ["zoom"],
                5,
                7,
                30,
                9,
                999
            ]
        ]
    ],
    "layout": {
        "text-field": ["get", "@name"],
        "text-font": ["Nunito Regular", "Noto Sans Regular"],
        "text-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            6,
            [
                "match",
                ["get", "subtype"],
                "region",
                10,
                8
            ],
            8,
            [
                "match",
                ["get", "subtype"],
                "region",
                11.5,
                9.5
            ],
            10,
            [
                "match",
                ["get", "subtype"],
                "region",
                13,
                11
            ]
        ],
        "text-letter-spacing": 0.15,
        "text-max-width": 6,
        "text-line-height": 1.3,
        "text-padding": 6,
        "text-allow-overlap": false
    },
    "paint": {
        "text-color": "$ink.500",
        "text-halo-color": "$white.400",
        "text-halo-width": 1.1
    }
}
