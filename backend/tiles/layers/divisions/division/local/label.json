            ["linear"],
            ["zoom"],
            11,
            [
                "match",
                ["get", "subtype"],
                ["localadmin", "borough", "macrohood"],
                12,
                10
            ],
            13,
            [
                "match",
                ["get", "subtype"],
                ["localadmin", "borough", "macrohood"],
                14,
                11.5
            ],
            15,
            [
                "match",
                ["get", "subtype"],
                ["localadmin", "borough", "macrohood"],
                16,
                13
            ]
        ],
        "text-letter-spacing": 0.15,
        "text-max-width": 7,
        "text-line-height": 1.3,
        "text-padding": 8,
        "text-allow-overlap": false
    },
    "paint": {
        "text-color": "hsl(0, 0%, 46%)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.8)",
