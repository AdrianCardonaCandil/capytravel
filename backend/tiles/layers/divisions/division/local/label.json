{
    "id": "division-local-label",
    "type": "symbol",
    "source": "divisions",
    "source-layer": "division",
    "minzoom": 11,
    "maxzoom": 17,
    "filter": [
        "all",
        [
            "in",
            ["get", "subtype"],
            [
                "literal",
                ["localadmin", "borough", "macrohood", "neighborhood", "microhood"]
            ]
        ],
        [
            "step",
            ["zoom"],
            [
                "in",
                ["get", "subtype"],
                [
                    "literal",
                    ["borough", "localadmin"]
                ]
            ],
            12,
            [
                "in",
                ["get", "subtype"],
                [
                    "literal",
                    ["borough", "localadmin", "macrohood"]
                ]
            ],
            14,
            [
                "in",
                ["get", "subtype"],
                [
                    "literal",
                    ["borough", "localadmin", "macrohood", "neighborhood"]
                ]
            ],
            15,
            true
        ]
    ],
    "layout": {
        "text-field": ["get", "@name"],
