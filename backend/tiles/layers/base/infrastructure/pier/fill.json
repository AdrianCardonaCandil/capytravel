{
    "id": "infrastructure-pier-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "infrastructure",
    "minzoom": 13,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "==",
            ["get", "subtype"],
            "pier"
        ],
        [
            "==",
            ["get", "class"],
            "pier"
        ]
    ],
    "paint": {
        "fill-color": "$urban.200",
        "fill-outline-color": "$urban.500"
    }
}
