{
    "id": "infrastructure-water-line",
    "type": "line",
    "source": "base",
    "source-layer": "infrastructure",
    "minzoom": 13,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "LineString"
        ],
        [
            "==",
            ["get", "subtype"],
            "water"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["dam", "fountain", "weir"]
            ]
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "$urban.200",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            1,
            16,
            3,
            20,
            6
        ]
    }
}
