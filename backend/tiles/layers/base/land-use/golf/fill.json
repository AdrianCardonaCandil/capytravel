{
    "id": "land-use-golf-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "land_use",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "==",
            ["get", "subtype"],
            "golf"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["golf_course", "fairway", "rough"]
            ]
        ]
    ],
    "layout": {
        "fill-sort-key": [
            "match",
            ["get", "class"],
            "golf_course",
            1,
            "rough",
            2,
            3
        ]
    },
    "paint": {
        "fill-color": [
            "match",
            ["get", "class"],
            "golf_course",
            "hsl(111, 41%, 83%)",
            "hsl(110, 38%, 84%)"
        ],
        "fill-outline-color": [
            "match",
            ["get", "class"],
            "golf_course",
            "hsl(112, 44%, 81%)",
            "hsl(111, 41%, 83%)"
        ]
    }
}
