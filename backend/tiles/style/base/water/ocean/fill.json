{
    "id": "water-ocean-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "water",
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "==",
            ["get", "subtype"],
            "ocean"
        ]
    ],
    "paint": {
        "fill-color": "hsl(196, 40%, 64%)",
        "fill-opacity": 1,
        "fill-outline-color": "transparent"
    }
}
