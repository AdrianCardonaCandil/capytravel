{
    "id": "land-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "land",
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "any",
            [
                "==",
                ["get", "class"],
                "land"
            ],
            [
                "!",
                ["has", "subtype"]
            ]
        ]
    ],
    "paint": {
        "fill-color": "hsl(31, 34%, 95.8%)",
        "fill-outline-color": "transparent"
    }
}
