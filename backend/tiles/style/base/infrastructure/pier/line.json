{
    "id": "infrastructure-pier-line",
    "type": "line",
    "source": "base",
    "source-layer": "infrastructure",
    "minzoom": 13,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "LineString"
        ],
        [
            "==",
            ["get", "subtype"],
            "pier"
        ],
        [
            "==",
            ["get", "class"],
            "pier"
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsl(31, 34%, 93%)",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            1,
            16,
            3,
            20,
            6
        ]
    }
}
