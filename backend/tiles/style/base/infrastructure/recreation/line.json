{
    "id": "infrastructure-recreation-line",
    "type": "line",
    "source": "base",
    "source-layer": "infrastructure",
    "minzoom": 13,
    "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["get", "subtype"], "recreation"],
        ["==", ["get", "class"], "roller_coaster"]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsl(48, 42%, 91%)",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12, 0.75,
            16, 2.5,
            20, 5
        ]
    }
}
