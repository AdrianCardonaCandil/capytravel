{
    "id": "infrastructure-line",
    "type": "line",
    "source": "base",
    "source-layer": "infrastructure",
    "minzoom": 13,
    "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        [
            "match",
            ["get", "subtype"],
            "airport", ["in", ["get", "class"], ["literal", ["runway", "taxiway"]]],
            "bridge", ["in", ["get", "class"], ["literal", ["bridge", "viaduct", "aqueduct"]]],
            "pier", ["==", ["get", "class"], "pier"],
            "quay", ["==", ["get", "class"], "quay"],
            "recreation", ["==", ["get", "class"], "roller_coaster"],
            "water", ["in", ["get", "class"], ["literal", ["dam", "fountain", "weir"]]],
            false
        ]
    ],
    "layout": {
        "line-sort-key": [
            "match",
            ["get", "subtype"],
            "airport", 1,
            "water", 2,
            "quay", 3,
            "pier", 4,
            "bridge", 5,
            "recreation", 6,
            0
        ],
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": [
            "match",
            ["get", "subtype"],
            "airport", " hsl(220, 42%, 88%)",
            ["water", "quay", "pier"], "hsl(31, 34%, 93%)",
            "bridge", "hsl(0, 38%, 95%)",
            "recreation", "hsl(48, 42%, 91%)",
            "transparent"
        ],
        "line-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            12, 0.75,
            16, 2.5,
            20, 5
        ]
    }
}
