{
    "id": "infrastructure-bridge-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "infrastructure",
    "minzoom": 13,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "==",
            ["get", "subtype"],
            "bridge"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["bridge", "viaduct", "aqueduct"]
            ]
        ]
    ],
    "paint": {
        "fill-color": "hsl(0, 38%, 95%)",
        "fill-outline-color": "hsl(0, 38%, 94%)"
    }
}
