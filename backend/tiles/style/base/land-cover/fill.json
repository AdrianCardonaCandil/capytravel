{
    "id": "land-cover-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "land_cover",
    "maxzoom": 13,
    "filter": ["==", ["geometry-type"], "Polygon"],
    "layout": {
        "fill-sort-key": [
            "match",
            ["get", "subtype"],
            "forest", 1,
            "barren", 2,
            "shrub", 3,
            "grass", 4,
            "crop", 5,
            "wetland", 6,
            "mangrove", 7,
            "moss", 8,
            "snow", 9,
            0
        ]
    },
    "paint": {
        "fill-color": [
            "match",
            ["get", "subtype"],
            "barren", "hsl(48, 52%, 87%)",
            "crop", "hsl(62, 62%, 81%)",
            "forest", "hsl(122, 52%, 76%)",
            "grass", "hsl(95, 60%, 79%)",
            "mangrove", "hsl(162, 54%, 76%)",
            "moss", "hsl(138, 48%, 72%)",
            "shrub", "hsl(78, 58%, 80%)",
            "snow", "hsl(210, 22%, 96%)",
            "wetland", "hsl(178, 56%, 80%)",
            "transparent"
        ],
        "fill-opacity": [
            "interpolate", ["linear"], ["zoom"],
            0, 1,
            6, 1,
            11, 0.2,
            13, 0
        ],
        "fill-outline-color": "transparent"
    }
}
