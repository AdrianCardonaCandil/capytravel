{
    "id": "land-cover-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "land_cover",
    "maxzoom": 13,
    "filter": [
        "==",
        ["geometry-type"],
        "Polygon"
    ],
    "layout": {
        "fill-sort-key": [
            "match",
            ["get", "subtype"],
            "forest",
            1,
            "barren",
            2,
            "shrub",
            3,
            "grass",
            4,
            "crop",
            5,
            "wetland",
            6,
            "mangrove",
            7,
            "moss",
            8,
            "snow",
            9,
            0
        ]
    },
    "paint": {
        "fill-color": [
            "match",
            ["get", "subtype"],
            "barren",
            "hsl(46, 48%, 88%)",
            "crop",
            "hsl(108, 30%, 88%)",
            "forest",
            "hsl(112, 44%, 81%)",
            "grass",
            "hsl(111, 41%, 83%)",
            "mangrove",
            "hsl(112, 44%, 81%)",
            "moss",
            "hsl(114, 46%, 79%)",
            "shrub",
            "hsl(110, 38%, 84%)",
            "snow",
            "hsl(0, 0%, 98%)",
            "wetland",
            "hsl(111, 41%, 83%)",
            "transparent"
        ],
        "fill-opacity": [
            "interpolate",
            ["linear"],
            ["zoom"],
            0,
            1,
            6,
            1,
            11,
            0.2,
            13,
            0
        ],
        "fill-outline-color": "transparent"
    }
}
