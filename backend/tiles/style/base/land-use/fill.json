{
    "id": "land-use-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "land_use",
    "minzoom": 12,
    "filter": [
        "all",
        ["==", ["geometry-type"], "Polygon"],
        [
            "match",
            ["get", "subtype"],
            "agriculture", ["in", ["get", "class"], ["literal", ["farmyard", "meadow", "farmland"]]],
            "campground", ["==", ["get", "class"], "camp_site"],
            "cemetery", ["in", ["get", "class"], ["literal", ["cemetery", "graveyard"]]],
            "education", ["in", ["get", "class"], ["literal", ["college", "university"]]],
            "entertainment", ["in", ["get", "class"], ["literal", ["water_park", "zoo", "theme_park"]]],
            "golf", ["in", ["get", "class"], ["literal", ["golf_course", "fairway", "rough"]]],
            "horticulture", ["in", ["get", "class"], ["literal", ["orchard", "garden", "flowerbed", "vineyard"]]],
            "medical", ["==", ["get", "class"], "hospital"],
            "military", ["in", ["get", "class"], ["literal", ["military", "base", "naval_base"]]],
            "park", ["in", ["get", "class"], ["literal", ["park", "dog_park", "village_green"]]],
            "protected", ["in", ["get", "class"], ["literal", ["nature_reserve", "national_park", "protected_landscape_seascape"]]],
            "recreation", ["in", ["get", "class"], ["literal", ["pitch", "recreation_ground", "playground", "track"]]],
            false
        ]
    ],
    "layout": {
        "fill-sort-key": [
            "match",
            ["get", "subtype"],
            "protected", 1,
            "agriculture", 2,
            "park", 3,
            "golf", ["match", ["get", "class"], "golf_course", 4, "rough", 5, 6],
            "campground", 7,
            "horticulture", 8,
            "military", 9,
            "recreation", ["match", ["get", "class"], "recreation_ground", 10, 11],
            "entertainment", 12,
            "education", 13,
            "medical", 14,
            "cemetery", 15,
            0
        ]
    },
    "paint": {
        "fill-color": [
            "match",
            ["get", "subtype"],
            ["protected", "park"], "hsl(118, 38%, 88%)",
            ["agriculture", "cemetery"], "hsl(75, 28%, 92%)",
            "golf", ["match", ["get", "class"], "golf_course", "hsl(118, 38%, 88%)", "hsl(118, 38%, 93%)"],
            ["campground", "horticulture", "recreation"], "hsl(118, 38%, 93%)",
            "military", "hsl(213, 10%, 97%)",
            ["education", "entertainment"], "hsl(48, 42%, 93%)",
            "medical", "hsl(0, 38%, 95%)",
            "transparent"
        ],
        "fill-outline-color": [
            "match",
            ["get", "subtype"],
            ["protected", "park"], "hsl(118, 38%, 86%)",
            ["agriculture", "cemetery"], "hsl(75, 28%, 90%)",
            "golf", ["match", ["get", "class"], "golf_course", "hsl(118, 38%, 86%)", "hsl(118, 38%, 91%)"],
            ["campground", "horticulture", "recreation"], "hsl(118, 38%, 91%)",
            "military", "hsl(213, 19%, 96%)",
            ["education", "entertainment"], "hsl(48, 42%, 91%)",
            "medical", "hsl(0, 38%, 94%)",
            "transparent"
        ]
    }
}
