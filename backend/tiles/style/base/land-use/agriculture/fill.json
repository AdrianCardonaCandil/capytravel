{
    "id": "land-use-agriculture-fill",
    "type": "fill",
    "source": "base",
    "source-layer": "land_use",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "==",
            ["get", "subtype"],
            "agriculture"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["farmyard", "meadow", "farmland"]
            ]
        ]
    ],
    "paint": {
        "fill-color": "hsl(75, 28%, 92%)",
        "fill-outline-color": "hsl(75, 28%, 90%)"
    }
}
