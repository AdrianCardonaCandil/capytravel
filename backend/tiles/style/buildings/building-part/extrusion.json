{
    "id": "bulding-part-extrusion",
    "type": "fill-extrusion",
    "source": "buildings",
    "source-layer": "building_part",
    "minzoom": 14,
    "filter": [
        "==",
        ["geometry-type"],
        "Polygon"
    ],
    "paint": {
        "fill-extrusion-color": "hsl(31, 30%, 86%)",
        "fill-extrusion-base": [
            "case",
            [
                ">=",
                ["get", "min_height"],
                0
            ],
            ["get", "min_height"],
            0
        ],
        "fill-extrusion-height": [
            "case",
            ["has", "height"],
            ["get", "height"],
            0
        ],
        "fill-extrusion-opacity": [
            "interpolate",
            ["linear"],
            ["zoom"],
            15,
            0.4,
            16,
            0.65
        ]
    }
}
