{
    "id": "building-fill",
    "type": "fill",
    "source": "buildings",
    "source-layer": "building",
    "minzoom": 14,
    "filter": [
        "all",
        [
            "==",
            ["geometry-type"],
            "Polygon"
        ],
        [
            "!=",
            ["get", "has_parts"],
            "true"
        ]
    ],
    "paint": {
        "fill-color": "hsl(210, 16%, 89%)",
        "fill-outline-color": "hsl(210, 15%, 86%)"
    }
}
