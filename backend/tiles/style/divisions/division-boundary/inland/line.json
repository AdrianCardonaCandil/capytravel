{
    "id": "division-boundary-inland-line",
    "type": "line",
    "source": "divisions",
    "source-layer": "division_boundary",
    "filter": [
        "all",
        [
            "step",
            ["zoom"],
            true,
            8,
            [
                "!=",
                ["get", "class"],
                "maritime"
            ]
        ]
    ],
    "paint": {
        "line-color": [
            "match",
            ["get", "class"],
            "maritime",
            "hsl(0, 0%, 100%)",
            "hsl(0, 0%, 46%)"
        ],
        "line-width": [
            "interpolate",
            ["linear"],
            ["zoom"],
            3,
            [
                "match",
                ["get", "subtype"],
                ["country", "dependency"],
                1,
                ["region", "macroregion"],
                0.7,
                ["county", "macrocounty"],
                0.5,
                0.1
            ],
            8,
            [
                "match",
                ["get", "subtype"],
                ["country", "dependency"],
                1.25,
                ["region", "macroregion"],
                0.85,
                ["county", "macrocounty"],
                0.65,
                0.15
            ],
            12,
            [
                "match",
                ["get", "subtype"],
                ["country", "dependency"],
                1.75,
                ["region", "macroregion"],
                1.25,
                ["county", "macrocounty"],
                0.9,
                0.2
            ],
            16,
            [
                "match",
                ["get", "subtype"],
                ["country", "dependency"],
                2,
                ["region", "macroregion"],
                1.5,
                ["county", "macrocounty"],
                1,
                0.2
            ]
        ],
        "line-opacity": [
            "match",
            ["get", "subtype"],
            ["country", "dependency"],
            0.35,
            ["region", "macroregion"],
            0.45,
            ["county", "macrocounty"],
            0.55,
            0.5
        ]
    },
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    }
}
