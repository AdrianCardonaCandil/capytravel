{
    "id": "road-residential-casing",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "==",
            ["get", "class"],
            "residential"
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": [
            "step",
            ["zoom"],
            "hsla(0, 0%, 0%, 0)",
            14,
            "hsl(210, 16%, 84%)"
        ],
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            14,
            0.8,
            20,
            2
        ],
        "line-gap-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            0.2,
            14,
            0.8,
            16,
            3,
            20,
            6
        ]
    }
}
