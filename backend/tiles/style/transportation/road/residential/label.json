{
    "id": "road-residential-label",
    "type": "symbol",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 15,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "==",
            ["get", "class"],
            "residential"
        ]
    ],
    "layout": {
        "text-field": ["get", "@name"],
        "text-font": ["Nunito Regular", "Noto Sans Regular"],
        "text-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            15,
            6,
            18,
            12
        ],
        "text-letter-spacing": 0.1,
        "text-max-angle": 30,
        "symbol-placement": "line",
        "symbol-spacing": [
            "interpolate",
            ["linear"],
            ["zoom"],
            12,
            150,
            18,
            450,
            22,
            1500
        ]
    },
    "paint": {
        "text-color": "hsl(38, 18%, 40%)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.7)",
        "text-halo-width": 1
    }
}
