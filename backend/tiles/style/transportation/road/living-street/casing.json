{
    "id": "road-living-street-casing",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        ["==", ["get", "subtype"], "road"],
        ["==", ["get", "class"], "living_street"]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": ["step", ["zoom"], "hsla(0, 0%, 0%, 0)", 14, "hsl(213, 19%, 91%)"],
        "line-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            14, 0.8,
            20, 2
        ],
        "line-gap-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            13, 0.2,
            14, 0.6,
            16, 2.5,
            20, 5
        ]
    }
}
