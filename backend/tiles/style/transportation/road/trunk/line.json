{
    "id": "road-trunk-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "==",
            ["get", "class"],
            "trunk"
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsl(0, 0%, 100%)",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            5,
            0.4,
            8,
            0.8,
            12,
            2.5,
            16,
            7,
            20,
            14
        ]
    }
}
