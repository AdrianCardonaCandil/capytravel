{
    "id": "road-other-casing",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["unclassified", "service", "unknown"]
            ]
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": [
            "step",
            ["zoom"],
            "hsla(0, 0%, 0%, 0)",
            12,
            "hsl(213, 19%, 91%)"
        ],
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            0.5,
            18,
            1,
            20,
            2
        ],
        "line-gap-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            0.2,
            16,
            2,
            20,
            4
        ]
    }
}
