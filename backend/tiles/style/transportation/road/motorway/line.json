{
    "id": "road-motorway-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        ["==", ["get", "subtype"], "road"],
        ["==", ["get", "class"], "motorway"]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsl(38, 18%, 85%)",
        "line-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            12, 3,
            16, 8,
            20, 16
        ]
    }
}
