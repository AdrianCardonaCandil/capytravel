{
    "id": "road-motorway-casing",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        ["==", ["get", "subtype"], "road"],
        ["==", ["get", "class"], "motorway"]
    ],
    "layout": {
        "line-cap": [
            "step", ["zoom"],
            "butt", 13,
            "round"
        ],
        "line-join": [
            "step", ["zoom"],
            "miter", 13,
            "round"
        ]
    },
    "paint": {
        "line-color": [
            "step", ["zoom"],
            "hsla(0, 0%, 0%, 0)", 8,
            "hsl(38, 18%, 77%)"
        ],
        "line-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            14, 1,
            20, 2
        ],
        "line-gap-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            4, 0.5,
            8, 1,
            12, 3,
            16, 8,
            20, 16
        ]
    }
}
