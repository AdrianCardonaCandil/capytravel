{
    "id": "road-steps-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 15,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "==",
            ["get", "class"],
            "steps"
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsla(0, 0%, 100%, 0.7)",
        "line-dasharray": [0.5, 0.25],
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            0,
            18,
            6,
            22,
            80
        ]
    }
}
