{
    "id": "road-secondary-casing",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "==",
            ["get", "class"],
            "secondary"
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": [
            "step",
            ["zoom"],
            "hsla(0, 0%, 0%, 0)",
            12,
            "hsl(213, 19%, 91%)"
        ],
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            14,
            0.8,
            20,
            2
        ],
        "line-gap-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            9,
            0.3,
            12,
            1.5,
            16,
            5,
            20,
            10
        ]
    }
}
