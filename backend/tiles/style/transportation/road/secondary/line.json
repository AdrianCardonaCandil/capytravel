{
    "id": "road-secondary-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        ["==", ["get", "subtype"], "road"],
        ["==", ["get", "class"], "secondary"]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsl(0, 0%, 100%)",
        "line-width": [
            "interpolate", ["exponential", 1.5], ["zoom"],
            9, 0.3,
            12, 1.5,
            16, 5,
            20, 10
        ]
    }
}
