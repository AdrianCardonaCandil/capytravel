{
    "id": "water-label",
    "type": "symbol",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 13,
    "filter": [
        "==",
        ["get", "subtype"],
        "water"
    ],
    "layout": {
        "text-field": ["get", "@name"],
        "text-font": ["Nunito Italic", "Noto Sans Italic"],
        "text-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            13,
            10,
            16,
            12
        ],
        "text-max-angle": 30,
        "symbol-placement": "line",
        "symbol-spacing": 500
    },
    "paint": {
        "text-color": "hsl(198, 40%, 55%)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.7)",
        "text-halo-width": 1
    }
}
