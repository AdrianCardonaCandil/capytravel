{
    "id": "rail-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "==",
        ["get", "subtype"],
        "rail"
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "hsla(38, 38%, 80%, 0.7)",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            8,
            0.2,
            12,
            0.5,
            16,
            2,
            20,
            4
        ],
        "line-dasharray": [2, 2]
    }
}
