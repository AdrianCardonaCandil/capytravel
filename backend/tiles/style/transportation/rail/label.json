{
    "id": "rail-label",
    "type": "symbol",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 13,
    "filter": [
        "==",
        ["get", "subtype"],
        "rail"
    ],
    "layout": {
        "text-field": ["get", "@name"],
        "text-font": ["Nunito Regular", "Noto Sans Regular"],
        "text-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            13,
            8,
            18,
            12
        ],
        "text-max-angle": 30,
        "symbol-placement": "line",
        "symbol-spacing": [
            "interpolate",
            ["linear"],
            ["zoom"],
            13,
            200,
            18,
            500
        ]
    },
    "paint": {
        "text-color": "hsl(38, 18%, 40%)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.7)",
        "text-halo-width": 1
    }
}
