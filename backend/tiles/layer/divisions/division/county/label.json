{
    "id": "division-county-label",
    "type": "symbol",
    "source": "divisions",
    "source-layer": "division",
    "maxzoom": 13,
    "filter": [
        "all",
        [
            "in",
            ["get", "subtype"],
            [
                "literal",
                ["macrocounty", "county"]
            ]
        ],
        [
            "<=",
            [
                "length",
                ["get", "@name"]
            ],
            [
                "step",
                ["zoom"],
                12,
                10,
                999
            ]
        ]
    ],
    "layout": {
        "text-field": ["get", "@name"],
        "text-font": ["Nunito Regular", "Noto Sans Regular"],
        "text-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            8,
            [
                "match",
                ["get", "subtype"],
                "county",
                9.5,
                8
            ],
            10,
            [
                "match",
                ["get", "subtype"],
                "county",
                11,
                9
            ],
            12,
            [
                "match",
                ["get", "subtype"],
                "county",
                12,
                10
            ]
        ],
        "text-letter-spacing": 0.1,
        "text-max-width": 7,
        "text-line-height": 1.3,
        "text-padding": 6,
        "text-allow-overlap": false
    },
    "paint": {
        "text-color": "$ink.400",
        "text-halo-color": "$white.400",
        "text-halo-width": 1.1
    }
}
