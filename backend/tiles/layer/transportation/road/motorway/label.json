{
    "id": "road-motorway-label",
    "type": "symbol",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 13,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "==",
            ["get", "class"],
            "motorway"
        ]
    ],
    "layout": {
        "text-field": ["get", "@name"],
        "text-font": ["Nunito Medium", "Noto Sans Medium"],
        "text-size": [
            "interpolate",
            ["linear"],
            ["zoom"],
            12,
            8,
            15,
            11,
            18,
            16
        ],
        "text-letter-spacing": 0.15,
        "text-max-angle": 30,
        "symbol-placement": "line",
        "symbol-spacing": [
            "interpolate",
            ["linear"],
            ["zoom"],
            12,
            150,
            18,
            450,
            22,
            1500
        ]
    },
    "paint": {
        "text-color": "$roadblue.400",
        "text-halo-color": "$white.200",
        "text-halo-width": 1
    }
}
