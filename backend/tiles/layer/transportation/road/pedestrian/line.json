{
    "id": "road-pedestrian-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 15,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["pedestrian", "footway", "path", "track", "cycleway", "bridleway"]
            ]
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "$urban.200",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            0,
            18,
            6,
            22,
            80
        ]
    }
}
