{
    "id": "road-other-line",
    "type": "line",
    "source": "transportation",
    "source-layer": "segment",
    "minzoom": 12,
    "filter": [
        "all",
        [
            "==",
            ["get", "subtype"],
            "road"
        ],
        [
            "in",
            ["get", "class"],
            [
                "literal",
                ["unclassified", "service", "unknown"]
            ]
        ]
    ],
    "layout": {
        "line-cap": "round",
        "line-join": "round"
    },
    "paint": {
        "line-color": "$urban.400",
        "line-width": [
            "interpolate",
            ["exponential", 1.5],
            ["zoom"],
            12,
            0.2,
            16,
            2,
            20,
            4
        ]
    }
}
