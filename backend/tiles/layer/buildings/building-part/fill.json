{
    "id": "building-part-fill",
    "type": "fill",
    "source": "buildings",
    "source-layer": "building_part",
    "minzoom": 14,
    "filter": [
        "==",
        ["geometry-type"],
        "Polygon"
    ],
    "paint": {
        "fill-color": "hsl(210, 15%, 86%)",
        "fill-outline-color": "hsl(210, 16%, 84%)"
    }
}
